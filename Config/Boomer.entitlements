<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Boomer is intentionally NOT sandboxed. The desktop-pet features
	  (typing animation via input monitoring, sitting on the Terminal via the
	  Accessibility API, watching ~/Downloads and /Applications) all require
	  capabilities the App Store sandbox forbids. Distribution is direct +
	  notarized. Do not add com.apple.security.app-sandbox = true.
	-->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
